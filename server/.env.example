# Variables de `server/docker-compose.yml`.
# ⚠️ À saisir dans l'UI Coolify (Environment Variables), PAS dans un fichier
#    versionné : ce compte contrôle toute l'instance PocketBase.
#    Ce fichier n'est qu'un MODÈLE : il ne doit jamais contenir de vraie valeur.

# Superuser réappliqué à CHAQUE démarrage (`superuser upsert` dans l'entrypoint de
# l'image) : le compte est recréé s'il manque, et son mot de passe est remis à cette
# valeur — y compris après l'import d'une base existante. C'est donc l'accès admin
# de référence, et il doit être traité comme tel.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Version de l'image PocketBase (tag de ghcr.io/muchobien/pocketbase).
# Épinglée : une montée de version se décide, elle ne se subit pas au redéploiement.
PB_VERSION=0.39.6

TZ=Europe/Paris
