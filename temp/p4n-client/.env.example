# Copiez ce fichier en .env puis renseignez les valeurs.
# La lecture publique fonctionne SANS identifiants (mode invité).

P4N_HOST=park4night.com
P4N_PUB_HOST=pub.park4night.com

P4N_APP_VERSION=7.1.60
P4N_PLATFORM=ANDROID
P4N_USER_AGENT=shared - 0.4.31
P4N_LANG=fr
P4N_LOCALE=fr_FR

P4N_LAT=45.7640
P4N_LON=4.8357

# Identifiants park4night (optionnel — mot de passe EN CLAIR, haché en SHA-256 par le client)
P4N_USERNAME=
P4N_PASSWORD=
P4N_USER_ID=
P4N_IS_MONTH_PREMIUM=false
P4N_IS_YEAR_PREMIUM=false

# Clé Google Maps (extraite du binaire — facultatif)
GOOGLE_MAPS_KEY=
