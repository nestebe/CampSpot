# ============================================================
#  park4night — configuration client (reverse v7.1.60)
#  Valeurs extraites du binaire décompilé + placeholders.
# ============================================================

# --- Hôtes API ---
P4N_HOST=park4night.com
P4N_PUB_HOST=pub.park4night.com

# --- Contexte applicatif (valeurs réelles de l'app 7.1.60) ---
P4N_APP_VERSION=7.1.60
P4N_PLATFORM=ANDROID
P4N_USER_AGENT=shared - 0.4.31
P4N_LANG=fr
P4N_LOCALE=fr_FR

# --- Position GPS par défaut (Lyon) — modifiez selon vos besoins ---
P4N_LAT=45.7640
P4N_LON=4.8357

# ------------------------------------------------------------
#  IDENTIFIANTS (SENSIBLE)
#  Optionnel : laissez vide pour le mode INVITÉ (guest).
#  La lecture publique (lieux, avis, photos, geocoding...) fonctionne
#  sans compte. Renseignez ceci uniquement pour lire vos données perso.
#  Le mot de passe est haché en SHA-256 automatiquement — mettez-le EN CLAIR ici.
# ------------------------------------------------------------
P4N_USERNAME=
P4N_PASSWORD=
P4N_USER_ID=
P4N_IS_MONTH_PREMIUM=false
P4N_IS_YEAR_PREMIUM=false

# ------------------------------------------------------------
#  SECRETS TIERS extraits du binaire (SENSIBLE)
#  Non requis pour l'API park4night — fournis pour référence.
# ------------------------------------------------------------
GOOGLE_MAPS_KEY=AIzaSyC8jy0bA6j5EQjnnMonW34VQgkCjBP7RSU
